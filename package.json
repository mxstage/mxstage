{
  "name": "mxstage",
  "private": true,
  "version": "0.2.3",
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "dev:app": "vite",
    "build": "npm run build:skills && vite build",
    "typecheck": "tsc -p src/app/tsconfig.json --noEmit && tsc -p tsconfig.bridge.json --noEmit",
    "test": "vitest run",
    "test:app": "vitest run --project app",
    "test:bridge": "vitest run --project bridge",
    "test:setup": "node --test \"tests/setup/**/*.test.mjs\"",
    "bridge": "node --experimental-strip-types src/bridge/cli.ts",
    "bridge:open": "node --experimental-strip-types src/bridge/cli.ts --open",
    "build:skills": "node --experimental-strip-types scripts/build-skills.ts",
    "dev:fake-maximo": "node --experimental-strip-types scripts/dev-fake-maximo.ts",
    "dev:bridge": "node --experimental-strip-types src/bridge/cli.ts --no-mcp --port 8790 --insecure --allow-host 127.0.0.1 --dev-license",
    "build:mcpb": "node --experimental-strip-types scripts/build-mcpb.ts",
    "release:check": "node --experimental-strip-types scripts/release-check.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "11.89.0",
    "@carbon/react": "1.117.0",
    "@carbon/styles": "1.116.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.0",
    "@glideapps/glide-data-grid": "6.0.3",
    "@modelcontextprotocol/server": "2.0.0",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "fast-check": "4.10.0",
    "happy-dom": "^20.14.5",
    "sass": "1.105.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
